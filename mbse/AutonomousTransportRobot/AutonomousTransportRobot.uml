              <effect xmi:type="uml:OpaqueBehavior" xmi:id="_552bwOm-EfGuZY2fj6coJw" name="StopAndResetDelivery">
                <language>pseudocode</language>
                <body>stopMotors()
clearDeliveryContext()</body>
              </effect>
              <trigger xmi:type="uml:Trigger" xmi:id="_ra6F8Om-EfGuZY2fj6coJw" name="onArUcoDetected" event="_yq-DMOkOEfGet-f1W4k-Hw"/>
            </transition>
            <subvertex xmi:type="uml:Pseudostate" xmi:id="_P4DQIOkJEfGdjNdesuPUng" name="Initial"/>
            <subvertex xmi:type="uml:State" xmi:id="_Sa6OcOkJEfGdjNdesuPUng" name="WAIT_FOR_RFID"/>
            <subvertex xmi:type="uml:State" xmi:id="_DObnwOkKEfGdjNdesuPUng" name="FOLLOW_MAIN_LINE">
