            <transition xmi:type="uml:Transition" xmi:id="_ZCNgUOkOEfGet-f1W4k-Hw" name="T_MainLine_to_Junction" guard="_DkCSEOkPEfGet-f1W4k-Hw" source="_DObnwOkKEfGdjNdesuPUng" target="_TOIo4OkOEfGet-f1W4k-Hw">
              <ownedRule xmi:type="uml:Constraint" xmi:id="_DkCSEOkPEfGet-f1W4k-Hw" name="JunctionMarkerDetected">
                <specification xmi:type="uml:OpaqueExpression" xmi:id="_DkC5IOkPEfGet-f1W4k-Hw" name="constrain">
                  <language>pseudocode</language>
                  <body>lastMarkerId == 1</body>
                </specification>
              </ownedRule>
              <effect xmi:type="uml:OpaqueBehavior" xmi:id="_MUoIgOkQEfGet-f1W4k-Hw" name="StopAtJunction">
                <language>pseudocode</language>
                <body>stopMotors()</body>
              </effect>
              <trigger xmi:type="uml:Trigger" xmi:id="_4_k00OkOEfGet-f1W4k-Hw" name="onArUcoDetected" event="_yq-DMOkOEfGet-f1W4k-Hw"/>
