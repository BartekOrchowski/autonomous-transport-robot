              <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_80jBoOkWEfGmF6OFxmc3zQ" name="ExecutePackageDrop">
                <language>pseudocode</language>
                <body>releasePackage()</body>
              </doActivity>
            </subvertex>
            <subvertex xmi:type="uml:State" xmi:id="_MjQ9QOkXEfGmF6OFxmc3zQ" name="RETURN_TO_JUNCTION">
              <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_lUwg8OkXEfGmF6OFxmc3zQ" name="FollowReturnLine">
                <language>pseudocode</language>
                <body>followLineAndMonitorMarkers()</body>
              </doActivity>
            </subvertex>
