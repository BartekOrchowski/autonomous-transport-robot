            <transition xmi:type="uml:Transition" xmi:id="_8FGdQOm8EfGuZY2fj6coJw" name="T_ReturnJunction_to_Home" source="_wNEuUOkXEfGmF6OFxmc3zQ" target="_5JmVcOm8EfGuZY2fj6coJw"/>
            <transition xmi:type="uml:Transition" xmi:id="_WFEJwOm-EfGuZY2fj6coJw" name="T_ReturnHome_to_WaitForRFID" guard="_wv5NoOm-EfGuZY2fj6coJw" source="_5JmVcOm8EfGuZY2fj6coJw" target="_Sa6OcOkJEfGdjNdesuPUng">
