            <transition xmi:type="uml:Transition" xmi:id="_ID0pYOkKEfGdjNdesuPUng" name="T_RFID_to_FOLLOW_MAIN_LINE" guard="_ajrlAOkMEfGet-f1W4k-Hw" source="_Sa6OcOkJEfGdjNdesuPUng" target="_DObnwOkKEfGdjNdesuPUng">
              <ownedRule xmi:type="uml:Constraint" xmi:id="_ajrlAOkMEfGet-f1W4k-Hw" name="ValidRFID">
                <specification xmi:type="uml:OpaqueExpression" xmi:id="_ajsMEOkMEfGet-f1W4k-Hw" name="CheckValidRFID">
                  <language>pseudocode</language>
                  <body>isValidUID(lastUid)</body>
                </specification>
              </ownedRule>
              <effect xmi:type="uml:OpaqueBehavior" xmi:id="_zbIKQOkNEfGet-f1W4k-Hw" name="AssignDestination">
                <language>pseudocode</language>
                <body>setDestinationFromUID(lastUid)</body>
              </effect>
              <trigger xmi:type="uml:Trigger" xmi:id="_nAmOIOkLEfGet-f1W4k-Hw" name="onRFIDRead" event="_P3SJMOkLEfGet-f1W4k-Hw"/>
