            <subvertex xmi:type="uml:State" xmi:id="_TOIo4OkOEfGet-f1W4k-Hw" name="HANDLE_JUNCTION">
              <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_pgbM8OkTEfGmF6OFxmc3zQ" name="ExecuteTurn">
