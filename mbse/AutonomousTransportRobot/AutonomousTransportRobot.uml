            <subvertex xmi:type="uml:State" xmi:id="_58CDwOkTEfGmF6OFxmc3zQ" name="FOLLOW_BRANCH">
              <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_R45skOkUEfGmF6OFxmc3zQ" name="FollowBranchLine">
                <language>pseudocode</language>
                <body>followLineAndMonitorMarkers()</body>
              </doActivity>
            </subvertex>
