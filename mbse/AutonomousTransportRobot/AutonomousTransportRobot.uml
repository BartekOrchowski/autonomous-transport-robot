            <transition xmi:type="uml:Transition" xmi:id="_C7cOwOkUEfGmF6OFxmc3zQ" name="T_Junction_to_Branch" source="_TOIo4OkOEfGet-f1W4k-Hw" target="_58CDwOkTEfGmF6OFxmc3zQ"/>
            <transition xmi:type="uml:Transition" xmi:id="__tq1wOkUEfGmF6OFxmc3zQ" name="T_Branch_to_TurnAround" guard="_fDwH0OkVEfGmF6OFxmc3zQ" source="_58CDwOkTEfGmF6OFxmc3zQ" target="_lGTVkOkUEfGmF6OFxmc3zQ">
