              <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_HQKLAOm-EfGuZY2fj6coJw" name="FollowHomeLine">
                <language>pseudocode</language>
                <body>followLineAndMonitorMarkers()</body>
              </doActivity>
