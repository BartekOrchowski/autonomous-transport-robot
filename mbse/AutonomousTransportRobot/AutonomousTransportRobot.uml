            </transition>
            <transition xmi:type="uml:Transition" xmi:id="_rtXeQOkWEfGmF6OFxmc3zQ" name="T_TurnAround_to_DropPackage" source="_lGTVkOkUEfGmF6OFxmc3zQ" target="_mTQmAOkWEfGmF6OFxmc3zQ"/>
            <transition xmi:type="uml:Transition" xmi:id="_St23QOkXEfGmF6OFxmc3zQ" name="T_DropPackage_to_ReturnJunction" source="_mTQmAOkWEfGmF6OFxmc3zQ" target="_MjQ9QOkXEfGmF6OFxmc3zQ"/>
            <transition xmi:type="uml:Transition" xmi:id="_0VhxcOkXEfGmF6OFxmc3zQ" name="T_ReturnToJunction_to_HandleReturn" guard="_0Gsm0Om9EfGuZY2fj6coJw" source="_MjQ9QOkXEfGmF6OFxmc3zQ" target="_wNEuUOkXEfGmF6OFxmc3zQ">
